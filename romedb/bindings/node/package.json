{
  "name": "@romedb/node",
  "version": "0.2.17",
  "description": "RomeDB for Node.js: the embedded database (Linux x64 native addon) and a Web-API client for romedb serve and RomeDB Cloud",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.cjs" },
    "./client": { "types": "./client.d.ts", "node": "./client.cjs", "default": "./client.mjs" },
    "./values": { "types": "./values.d.ts", "node": "./values.cjs", "default": "./values.mjs" },
    "./embedded-client": { "types": "./embedded-client.d.ts", "default": "./embedded-client.cjs" },
    "./*": "./*"
  },
  "scripts": {
    "test": "node --test --test-concurrency=2 test.cjs client-native.test.cjs embedded-client.test.cjs shared-classes.test.cjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module Node16 types.test.ts client.types.test.ts embedded-client.types.test.ts values.types.test.ts",
    "prepack": "node -e \"require('./romedb.node')\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@romedb/client": "0.2.17"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "license": "MIT",
  "homepage": "https://github.com/romedb/romedb/tree/main/romedb/bindings/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romedb/romedb.git",
    "directory": "romedb/bindings/node"
  },
  "bugs": {
    "url": "https://github.com/romedb/romedb/issues"
  },
  "files": [
    "index.cjs",
    "client.cjs",
    "client.mjs",
    "client.d.ts",
    "embedded-client.cjs",
    "embedded-client.d.ts",
    "embedded-worker.cjs",
    "values.cjs",
    "values.mjs",
    "values.d.ts",
    "worker.cjs",
    "native.cjs",
    "index.d.ts",
    "romedb.node",
    "LICENSE.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_CRATE_NOTICES.md",
    "RUST-LIBRARY-NOTICES.html"
  ]
}
